rules_version = '2';

// Reguły Firestore dla Spokojny Rodzic
//
// Pojedyncza prosta reguła: user ma pełen dostęp do wszystkiego pod users/{jego_uid}.
// Pokrywa: data/, tokens/, profiles/ oraz wszystkie subkolekcje pod tymi ścieżkami.
//
// Bezpieczeństwo:
// - Tylko zalogowani userzy
// - User może operować tylko na swoich danych (request.auth.uid == userId)
// - Cloud Functions używają admin SDK który bypassuje rules → może pisać do tokenów wszystkich userów

service cloud.firestore {
  match /databases/{database}/documents {

    // Wszystko pod users/{uid} — user może czytać/pisać tylko swoje dane.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
