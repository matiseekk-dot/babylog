rules_version = '2';

// Reguły Firestore dla Spokojny Rodzic (v2.15.0)
//
// Polityka:
//
//   1. Dane dziecka: users/{uid}/data/{docId}, kontrakt useFirestore = {value}.
//      Dostęp ma właściciel oraz partnerzy wspólnego konta — partner to ktoś,
//      dla kogo istnieje users/{uid}/partners/{partnerUid}.
//
//   2. POLA CHRONIONE — zapisuje wyłącznie Admin SDK (Cloud Functions):
//      premium_purchased, premium_meta, trial_start, linked_owner, rc_event_*.
//
//   3. partners/* i partner_invites/* zapisują wyłącznie Cloud Functions
//      (createPartnerInvite / acceptPartnerInvite / removePartnerLink).
//
//   4. Każda podkolekcja ma własny, jawny match. Wcześniej ogólny
//      match /users/{userId}/{subcol}/{document=**} pasował też do "data"
//      i przy OR-semantyce reguł przepuszczał zapis do premium_purchased.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isPartner(userId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(userId)/partners/$(request.auth.uid));
    }

    function canAccess(userId) {
      return isOwner(userId) || isPartner(userId);
    }

    function isProtectedDoc(docId) {
      return docId == 'premium_purchased'
        || docId == 'premium_meta'
        || docId == 'trial_start'
        || docId == 'linked_owner'
        || docId.matches('rc_event_.*');
    }

    match /users/{userId}/data/{docId} {
      allow read: if canAccess(userId);
      allow write: if canAccess(userId)
        && !isProtectedDoc(docId)
        && request.resource.data.keys().hasOnly(['value']);
    }

    // Tokeny FCM — tylko własne urządzenia.
    match /users/{userId}/tokens/{tokenId} {
      allow read, write: if isOwner(userId);
    }

    // Lista partnerów — właściciel widzi wszystkich, partner tylko siebie.
    match /users/{userId}/partners/{partnerUid} {
      allow read: if isOwner(userId)
        || (signedIn() && request.auth.uid == partnerUid);
    }
  }
}
